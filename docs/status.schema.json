{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thawr.dev/schemas/status.json",
  "title": "thawr client status",
  "description": "Document served on the client's local socket (GET /status) and printed by `thawr client status --json`. Fields are only ever added.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "self", "server", "wireguard", "nat", "relay", "peers", "held", "lock", "routes", "exit_node", "advertised", "retrieved_at"],
  "properties": {
    "version": { "type": "string", "description": "Client binary version." },
    "self": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "peer_id", "ipv4", "kind"],
      "properties": {
        "name": { "type": "string" },
        "peer_id": { "type": "string" },
        "ipv4": { "type": "string", "description": "Overlay address." },
        "kind": { "$ref": "#/$defs/kind" }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addr", "state", "attempt", "next_retry_at", "unreachable_since", "generation", "last_message_at", "last_error", "version"],
      "properties": {
        "addr": { "type": "string", "description": "host:port of the control server." },
        "state": { "type": "string", "enum": ["connected", "reconnecting", "cached"] },
        "attempt": { "type": "integer", "minimum": 0, "description": "Failed connection attempts since the last successful one." },
        "next_retry_at": { "$ref": "#/$defs/nullableTime" },
        "unreachable_since": { "$ref": "#/$defs/nullableTime" },
        "generation": { "type": "integer", "minimum": 0, "description": "Netmap generation in use; 0 when none." },
        "last_message_at": { "$ref": "#/$defs/nullableTime" },
        "last_error": { "type": "string" },
        "version": { "type": "string", "description": "The server's version from the last netmap; empty until one arrived." }
      }
    },
    "wireguard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "interface", "listen_port"],
      "properties": {
        "backend": { "type": "string", "description": "kernel, userspace or fake." },
        "interface": { "type": "string" },
        "listen_port": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "nat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reflexive", "local"],
      "properties": {
        "type": { "type": "string", "enum": ["unknown", "none", "cone", "symmetric"] },
        "reflexive": { "type": "array", "items": { "type": "string" } },
        "local": { "type": "array", "items": { "type": "string" } }
      }
    },
    "relay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connected", "peers"],
      "properties": {
        "connected": { "type": "boolean" },
        "peers": { "type": "integer", "minimum": 0 }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "drops", "dropped_5m", "flows"],
      "properties": {
        "rules": { "type": "integer", "minimum": 0 },
        "drops": { "type": "integer", "minimum": 0 },
        "dropped_5m": { "type": "integer", "minimum": 0 },
        "flows": { "type": "integer", "minimum": 0 }
      }
    },
    "dns": {
      "type": "object",
      "description": "The <name>.thawr resolver; absent when the client runs with --dns off.",
      "additionalProperties": false,
      "required": ["listen", "state", "method", "names", "error"],
      "properties": {
        "listen": { "type": "string", "description": "ip:port the resolver listens on." },
        "state": { "type": "string", "enum": ["serving", "error"] },
        "method": { "type": "string", "enum": ["resolved", "hosts", "resolver-file", "nrpt", "none"], "description": "How the OS was told about the zone; none when not registered." },
        "names": { "type": "integer", "minimum": 0 },
        "error": { "type": "string" }
      }
    },
    "hub": { "$ref": "#/$defs/peer" },
    "peers": { "type": "array", "items": { "$ref": "#/$defs/peer" } },
    "held": {
      "type": "array",
      "description": "Netmap entries held out of the tunnel: the key differs from the pinned one (until `thawr client trust <name>`) or the network lock has not signed it (until a signer runs `thawr client lock sign <name>`).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ipv4", "kind", "owner", "pinned_key", "offered_key", "since", "reason"],
        "properties": {
          "name": { "type": "string", "description": "Peer name, or hub." },
          "ipv4": { "type": "string" },
          "kind": { "$ref": "#/$defs/kind" },
          "owner": { "type": "string" },
          "pinned_key": { "type": "string", "description": "The accepted WireGuard public key." },
          "offered_key": { "type": "string", "description": "The key the current netmap carries." },
          "since": { "type": "string", "format": "date-time" },
          "reason": { "type": "string", "enum": ["key_changed", "unsigned"] }
        }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "signer", "has_key", "generation", "signers", "rejected", "self_signed"],
      "description": "The network lock (spec 012) as this device sees it: the pinned signer record and whether this device may sign.",
      "properties": {
        "enabled": { "type": "boolean" },
        "signer": { "type": "boolean", "description": "This device holds a lock key the record names." },
        "has_key": { "type": "boolean", "description": "A lock key exists on this device (lock init or lock key)." },
        "generation": { "type": "integer", "minimum": 0 },
        "signers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["peer_id", "name", "key", "fingerprint"],
            "properties": {
              "peer_id": { "type": "string" },
              "name": { "type": "string", "description": "Signer's peer name when visible to this device; empty otherwise." },
              "key": { "type": "string", "description": "Lock public key (base64)." },
              "fingerprint": { "type": "string" }
            }
          }
        },
        "rejected": { "type": "string", "description": "Why the record the server offers (or its absence) was not adopted; empty when the pin matches." },
        "self_signed": { "type": "boolean", "description": "This device's own record is signed while the lock is on; other devices hold it until it is." }
      }
    },
    "routes": {
      "type": "array",
      "description": "Prefixes reached through peers (spec 013), the exit node's default route included while one is active.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prefix", "via"],
        "properties": {
          "prefix": { "type": "string" },
          "via": { "type": "string", "description": "Name of the peer carrying the prefix." }
        }
      }
    },
    "exit_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "state"],
      "properties": {
        "name": { "type": "string", "description": "Selected exit node; empty when none." },
        "state": { "type": "string", "enum": ["off", "active", "unavailable"] }
      }
    },
    "advertised": {
      "type": "array",
      "description": "Prefixes this device offers to carry and whether an admin approved them.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prefix", "approved"],
        "properties": {
          "prefix": { "type": "string" },
          "approved": { "type": "boolean" }
        }
      }
    },
    "retrieved_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "kind": { "type": "string", "enum": ["", "human", "server", "agent"] },
    "nullableTime": { "type": ["string", "null"], "format": "date-time" },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ipv4", "kind", "owner", "online", "public_key", "path", "path_endpoint", "probes", "endpoint_candidates", "last_handshake_at", "rx_bytes", "tx_bytes"],
      "properties": {
        "name": { "type": "string" },
        "ipv4": { "type": "string" },
        "kind": { "$ref": "#/$defs/kind" },
        "owner": { "type": "string", "description": "Owning user's name; empty when unowned." },
        "online": { "type": "boolean", "description": "The server currently has a sync stream from this peer." },
        "public_key": { "type": "string" },
        "path": { "type": "string", "enum": ["idle", "probing", "direct", "relay", "unreachable", "offline", "hub", "key_changed", "unsigned"] },
        "path_endpoint": { "type": "string", "description": "ip:port a direct path uses; empty otherwise." },
        "probes": { "type": "integer", "minimum": 0 },
        "endpoint_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["addr", "kind"],
            "properties": {
              "addr": { "type": "string" },
              "kind": { "type": "string", "enum": ["local", "reflexive", "stable"] }
            }
          }
        },
        "last_handshake_at": { "$ref": "#/$defs/nullableTime" },
        "rx_bytes": { "type": "integer", "minimum": 0 },
        "tx_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
